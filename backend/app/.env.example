# OpenAI API key - used for chat completions and embeddings
OPENAI_API_KEY=

# Only for the manual scripts (test_chat_latency.py, reingest_pdfs.py) - the same value as VITE_FIREBASE_API_KEY in
# frontend/.env. Not a secret: it only names the Firebase project.
FIREBASE_WEB_API_KEY=

# Firestore and Firebase token checks need no keys here: Cloud Run uses its service account,
# local runs use `gcloud auth application-default login`.

# Comma-separated list of allowed frontend origins for CORS, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=

# Optional: allow calling /rag/upload without auth (local development only - leave unset/false in production)
ALLOW_UNAUTHENTICATED_RAG_UPLOAD=false

# Comma-separated allowlist of accounts that may call /rag/upload, e.g.
# you@example.com,teammate@example.com - leave empty to allow any logged-in user.
ADMIN_EMAILS=
